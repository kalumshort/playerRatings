rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groupUsers/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groupUsers/$(groupId)/admins/$(request.auth.uid));
    }
    
    function isGroupOwner(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groupUsers/$(groupId)/owners/$(request.auth.uid));
    }

    function isGroupPublic(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public';
    }
    

    // --- PERMISSION CHECKS ---

    function canReadGroup(groupId) {
      return isGroupPublic(groupId) || isGroupMember(groupId) || isGroupAdmin(groupId) || isGroupOwner(groupId);
    }

    function canWriteGroup(groupId) {
      return (isGroupPublic(groupId) && isSignedIn()) || isGroupMember(groupId) || isGroupAdmin(groupId) || isGroupOwner(groupId);
    }

    // --- SECURITY VALIDATIONS (REUSABLE) ---

    // 1. Check for valid Rating Updates (Used in 3 different places)
    // - Creation: Starts with 1 vote, rating 0-10.
    // - Update: Votes +1, Rating goes up by Max 10.
    function isValidRatingUpdate() {
      return (
        // CASE 1: CREATION
        (resource == null 
         && request.resource.data.totalSubmits == 1
         && request.resource.data.totalRating <= 10)
        || 
        // CASE 2: UPDATE
        (resource != null
         // Rating Logic: Must go up, but Max 10 points
         && request.resource.data.totalRating >= resource.data.totalRating
         && (request.resource.data.totalRating - resource.data.totalRating) <= 10
         // Submit Logic: Must increase by exactly 1
         && (request.resource.data.totalSubmits == resource.data.totalSubmits + 1)
        )
      );
    }

    // =========================================================
    // 2. COLLECTION RULES
    // =========================================================

    // --- A. GROUPS & SUBCOLLECTIONS ---

    match /groups/{groupId} {
      allow read: if canReadGroup(groupId);
      allow write: if isGroupOwner(groupId); 

      match /seasons/{seasonId} {
        allow read: if canReadGroup(groupId);

        // 1. PLAYER SEASON TOTALS
        match /players/{playerId} {
           allow read: if canReadGroup(groupId);
           allow write: if canWriteGroup(groupId) && isValidRatingUpdate();

           // 2. PLAYER MATCH HISTORY (Nested)
           // Prevents spamming a specific match history for a player
           match /matches/{matchId} {
              allow read: if canReadGroup(groupId);
              allow write: if canWriteGroup(groupId) && isValidRatingUpdate();
           }
        }

        match /playerRatings/{matchId} {
          allow read: if canReadGroup(groupId);
          // General match data (like MOTM votes)
          // We ensure the total vote count only increases by 1
        allow write: if canWriteGroup(groupId) ;
             
          // 3. MATCH RATINGS AGGREGATE (For Community Average)
          match /players/{playerId} {
            allow read: if canReadGroup(groupId);
            allow write: if canWriteGroup(groupId) && isValidRatingUpdate();
          }
        }
        
        // 4. PREDICTIONS
        // Validating the 'totalTeamSubmits' or 'totalVotes'
      match /predictions/{matchId} {
          allow read: if canReadGroup(groupId);
          allow write: if canWriteGroup(groupId) && (
             resource == null 
             // Ensure "Total Team Submits" only increases by 1 (One prediction per click)
             || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['formations','positionConsensus','totalTeamSubmits', 'totalPlayersSubmits', 'result', 'preMatchMotm', 'preMatchMotmVotes', 'scorePredictions', 'homeGoals', 'awayGoals', 'totalScoreVotes']))
             // NOTE: Deep map validation is hard in Rules, but we can at least ensure 
             // high-level counters like 'totalVotes' (if you add them) increment by 1.
          );
        }

        // Live stats and Moods (Lower risk, standard checks)
        match /livePlayerStats/{matchId} {
           allow read: if canReadGroup(groupId);
           allow write: if canWriteGroup(groupId);
        }

        match /fixtureMoods/{matchId} {
          allow read: if canReadGroup(groupId);
          allow write: if canWriteGroup(groupId);
        }
        
        match /eventsReactions/{matchId} {
          allow read: if canReadGroup(groupId);
          allow write: if canWriteGroup(groupId);
        }
        
        match /seasonPredictions/{questionKey} {
          allow read: if canReadGroup(groupId);
          allow write: if canWriteGroup(groupId);
        }
      }
    }

    // --- B. USER DATA ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- C. PUBLIC READ-ONLY DATA ---
    match /fixtures/{season}/fixtures/{fixtureId} {
      allow read: if true; 
    }

    match /teamSquads/{squadId} {
      allow read: if true;
      match /season/{seasonId} {
        allow read: if true;
      }
    }

    match /playerImages/{allImages=**} {
      allow read: if true;
    }

    // --- D. INVITES & MEMBERSHIP ---
    match /groupInvites/{inviteId} {
      allow read: if request.auth != null && (
    // We look up the group document to check if the current user is the ownerId
    get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid
  );
       allow write, create,  delete: if request.auth != null && (
    // We look up the group document to check if the current user is the ownerId
    get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid
  );
    }
    
    match /groupUsers/{groupId}/members/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; 
    }
    
    match /groupUsers/{groupId}/admins/{userId} {
      allow read: if true; 
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}