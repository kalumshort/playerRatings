# Non-secret runtime config for Cloud Functions. Deployed with the functions.
# Secrets (FOOTBALL_API_KEY, GMAIL_APP_PASSWORD) do NOT belong here — those live
# in Secret Manager via `firebase functions:secrets:set`.

# UIDs allowed to run admin-only callables (syncLeagueCatalogue,
# listTrackedLeagues). Comma-separated Firebase Auth uids. Leaving this empty
# denies everyone, which is the safe default — set it before you need it.
ADMIN_UIDS=

# Club registry reconcile safety switch.
#
# While this is true, the nightly updateFixtures job logs the clubs it *would*
# create and archive without writing any of them. Leave it on for the first run
# after a season rollover, check the logs:
#
#   firebase functions:log --only updateFixtures
#
# confirm the promoted clubs are listed as created and the relegated ones as
# archived, then set this to false and redeploy. Archiving is what freezes a
# club's pages and closes it to new members, so it is worth one night's delay.
RECONCILE_DRY_RUN=true
